{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "APP_DATABASE_URL",
    "TEST_DATABASE_URL",
    "TEST_APP_DATABASE_URL",
    "PORT",
    "E2E_DATABASE_URL",
    "E2E_APP_DATABASE_URL",
    "CI",
    "PLAYWRIGHT_BROWSERS_PATH"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "build"]
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test:e2e": {
      "dependsOn": ["build", "@seatline/api#build"],
      "cache": false
    }
  }
}
