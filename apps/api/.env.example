# Copy to .env. Values match infra/docker-compose.yml (local dev only).

# Owner connection: migrations + seed. Never used by the running API.
DATABASE_URL="postgresql://seatline:seatline@localhost:5432/seatline"
# What the API connects as: not the table owner, so Row-Level Security applies.
APP_DATABASE_URL="postgresql://seatline_app:seatline_app@localhost:5432/seatline"
# Connections per process: queries (Prisma) and the job queue (pg-boss). The Azure B1ms
# server allows 50 in all — 2 API copies + the nightly job must stay below that.
# DB_POOL_SIZE=5
# JOB_POOL_SIZE=3

# Used by `pnpm test` (tests reset this database).
TEST_DATABASE_URL="postgresql://seatline:seatline@localhost:5432/seatline_test"
TEST_APP_DATABASE_URL="postgresql://seatline_app:seatline_app@localhost:5432/seatline_test"

PORT=3001
# Dev-only auth: trust x-tenant-id / x-user-id headers. Replaced by Entra ID in Phase 4.
DEV_AUTH=true

# File storage. "UseDevelopmentStorage=true" = Azurite from docker-compose.
AZURE_STORAGE_CONNECTION_STRING="UseDevelopmentStorage=true"
AZURE_STORAGE_CONTAINER="floor-plans"

# Microsoft sign-in + people sync (leave empty locally; dev sign-in is used instead).
# INTERNAL_AUTH_SECRET must be the same value as in apps/web (32+ random characters).
INTERNAL_AUTH_SECRET=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# E-mail (sign-in links, invitations). Off unless APP_URL and SMTP (or MAIL_OUTBOX) are set.
# APP_URL=http://localhost:3000
# SMTP_HOST=asmtp.mail.hostpoint.ch
# SMTP_PORT=465
# SMTP_USER=hello@seatline.ch
# SMTP_PASSWORD=
# MAIL_OUTBOX=/tmp/seatline-mail   # local/tests: write e-mails as files instead

# Billing with Stripe (optional — billing is off unless all three are set)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...

# Plan import: the Python plan engine (apps/plan-engine). Unset = import is off.
# PLAN_ENGINE_URL=http://localhost:8000
