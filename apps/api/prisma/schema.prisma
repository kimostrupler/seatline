// Seatline database schema.
//
// Child tables reference parents by (tenant_id, id), so a row can never point at another
// tenant's data (foreign-key checks ignore RLS).
//
// Things Prisma can't express live in hand-written SQL inside the migrations
// (see prisma/migrations/*/migration.sql and README "Database rules"):
//   - Row-Level Security policies (tenant isolation)
//   - partial unique indexes: one open assignment per seat / per person
//   - triggers that make assignment history and the audit log append-only

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppRole {
  admin
  editor
  viewer

  @@map("app_role")
}

enum RoomType {
  office
  open_space
  meeting
  other

  @@map("room_type")
}

enum SeatType {
  desk
  office

  @@map("seat_type")
}

enum SeatStatus {
  active
  blocked

  @@map("seat_status")
}

enum AssignmentKind {
  assigned
  reserved

  @@map("assignment_kind")
}

model Tenant {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String
  slug                   String    @unique
  entraTenantId          String?   @unique @map("entra_tenant_id") @db.Uuid
  dataRegion             String    @default("switzerlandnorth") @map("data_region")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// role for people who sign in without one (null = only people an admin gave a role)
  defaultAppRole         AppRole?  @default(viewer) @map("default_app_role")
  peopleSyncedAt         DateTime? @map("people_synced_at") @db.Timestamptz(3)
  /// last Microsoft Graph sync: { ok, error?, created, updated, deactivated, seatsFreed }
  peopleSyncStatus       Json?     @map("people_sync_status")
  /// keep seat history and the activity log this many months (null = forever); nightly purge
  historyRetentionMonths Int?      @default(24) @map("history_retention_months")
  /// e-mail notices about changes (people leaving/joining, teams, moves) go to these addresses
  notifyEmails           String[]  @default([]) @map("notify_emails")
  notifyEvents           String[]  @default(["left", "joined", "team", "moves"]) @map("notify_events")
  notifyLanguage         String    @default("de") @map("notify_language")
  /// people get an e-mail when they get a new desk
  notifyPeople           Boolean   @default(true) @map("notify_people")
  /// a demo workspace (sample data for visitors; deleted after a day)
  isDemo                 Boolean   @default(false) @map("is_demo")
  /// last trial reminder sent (days left: 7, then 1)
  trialReminded          Int?      @map("trial_reminded") @db.SmallInt
  onboardingSent         Int       @default(0) @map("onboarding_sent") @db.SmallInt
  /// free trial until (new workspaces: 30 days); afterwards a subscription is needed
  trialEndsAt            DateTime  @default(dbgenerated("(now() + '30 days'::interval)")) @map("trial_ends_at") @db.Timestamptz(3)
  stripeCustomerId       String?   @unique @map("stripe_customer_id")
  stripeSubscriptionId   String?   @unique @map("stripe_subscription_id")
  /// Stripe's subscription status (active, trialing, past_due, canceled, unpaid, …)
  billingStatus          String?   @map("billing_status")
  billingPeriodEnd       DateTime? @map("billing_period_end") @db.Timestamptz(3)
  /// seats on the subscription (synced nightly with the active seats)
  billedSeats            Int?      @map("billed_seats")

  people       Person[]
  buildings    Building[]
  floors       Floor[]
  rooms        Room[]
  seats        Seat[]
  assignments  SeatAssignment[]
  auditLog     AuditLog[]
  dashboards   DashboardLayout[]
  movePlans    MovePlan[]
  moveItems    MovePlanItem[]
  floorMarkers FloorMarker[]
  teamPlans    TeamPlan[]
  leads        Lead[]
  deskBookings DeskBooking[]
  leadMessages LeadMessage[]

  @@map("tenants")
}

model Person {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  entraObjectId String?   @map("entra_object_id") @db.Uuid
  email         String
  displayName   String    @map("display_name")
  department    String?
  /// team set by an admin: the Microsoft sync doesn't overwrite `department`
  teamManual    Boolean   @default(false) @map("team_manual")
  jobTitle      String?   @map("job_title")
  /// null = no access to the app (still assignable to a seat)
  appRole       AppRole?  @map("app_role")
  active        Boolean   @default(true)
  syncedAt      DateTime? @map("synced_at") @db.Timestamptz(3)
  /// when the person was marked as having left (people sync)
  leftAt        DateTime? @map("left_at") @db.Timestamptz(3)
  /// HR: the person leaves on this day (the nightly job frees their seat then)
  leavesOn      DateTime? @map("leaves_on") @db.Date
  /// personal data removed ("forgotten"); the seat history stays, unnamed
  forgottenAt   DateTime? @map("forgotten_at") @db.Timestamptz(3)

  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  assignments  SeatAssignment[]  @relation("AssignmentPerson")
  bookings     DeskBooking[]
  assignedByMe SeatAssignment[]  @relation("AssignmentAssignedBy")
  dashboard    DashboardLayout[]
  plansMade    MovePlan[]        @relation("MovePlanCreatedBy")
  plansSet     MovePlan[]        @relation("MovePlanScheduledBy")
  plannedMoves MovePlanItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, entraObjectId])
  @@unique([tenantId, email])
  @@index([tenantId, displayName])
  @@map("people")
}

model Building {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  address   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  floors Floor[]

  @@unique([tenantId, id])
  @@map("buildings")
}

model Floor {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  buildingId    String   @map("building_id") @db.Uuid
  name          String
  level         Int
  planFileKey   String?  @map("plan_file_key")
  planWidth     Float?   @map("plan_width")
  planHeight    Float?   @map("plan_height")
  /// plan units per metre
  scale         Float?
  /// desk size in metres (null = 1.6 × 0.8); desks are drawn at this size once the scale is known
  deskWidth     Float?   @map("desk_width")
  deskDepth     Float?   @map("desk_depth")
  /// "floor" = 1.01, 1.02…; "room" = 1.04-A, 1.04-B…
  seatNumbering String   @default("floor") @map("seat_numbering")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  building Building      @relation(fields: [tenantId, buildingId], references: [tenantId, id], onDelete: Restrict)
  rooms    Room[]
  seats    Seat[]
  markers  FloorMarker[]

  @@unique([tenantId, id])
  @@index([tenantId, buildingId])
  @@map("floors")
}

model Room {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  floorId   String   @map("floor_id") @db.Uuid
  name      String
  type      RoomType @default(office)
  /// [{ x, y }, …] in plan units
  polygon   Json
  /// meeting rooms: how many people fit, and what's in it (screen, video, whiteboard, phone)
  capacity  Int?
  equipment String[] @default([])
  /// team zone: the area of this team (department name)
  team      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  floor  Floor  @relation(fields: [tenantId, floorId], references: [tenantId, id], onDelete: Restrict)
  seats  Seat[]

  @@unique([tenantId, id])
  @@unique([tenantId, floorId, id])
  @@index([tenantId, floorId])
  @@map("rooms")
}

model Seat {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  floorId   String     @map("floor_id") @db.Uuid
  roomId    String?    @map("room_id") @db.Uuid
  label     String
  x         Float
  y         Float
  rotation  Float      @default(0)
  type      SeatType   @default(desk)
  status    SeatStatus @default(active)
  /// standing, two_screens, docking, window, quiet, accessible
  features  String[]   @default([])
  /// a shared desk has no permanent person: people book it for a day (desk_bookings)
  shared    Boolean    @default(false)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  floor       Floor            @relation(fields: [tenantId, floorId], references: [tenantId, id], onDelete: Restrict)
  room        Room?            @relation(fields: [tenantId, floorId, roomId], references: [tenantId, floorId, id], onDelete: Restrict)
  assignments SeatAssignment[]
  plannedFor  MovePlanItem[]
  bookings    DeskBooking[]

  @@unique([tenantId, id])
  @@unique([floorId, label])
  @@index([tenantId, floorId])
  @@map("seats")
}

/// Append-only history. Rows are only ever inserted, then closed once (end_at set).
model SeatAssignment {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  seatId       String         @map("seat_id") @db.Uuid
  personId     String?        @map("person_id") @db.Uuid
  kind         AssignmentKind
  reservedFor  String?        @map("reserved_for")
  startAt      DateTime       @default(now()) @map("start_at") @db.Timestamptz(3)
  endAt        DateTime?      @map("end_at") @db.Timestamptz(3)
  assignedById String         @map("assigned_by") @db.Uuid
  note         String?

  tenant     Tenant  @relation(fields: [tenantId], references: [id])
  seat       Seat    @relation(fields: [tenantId, seatId], references: [tenantId, id], onDelete: Restrict)
  person     Person? @relation("AssignmentPerson", fields: [tenantId, personId], references: [tenantId, id], onDelete: Restrict)
  assignedBy Person  @relation("AssignmentAssignedBy", fields: [tenantId, assignedById], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, seatId, startAt])
  @@index([tenantId, personId, startAt])
  @@map("seat_assignments")
}

/// A shared desk booked for one day. Cancelling sets cancelled_at (kept); only the privacy
/// functions remove old bookings. One per desk per day and one per person per day (partial
/// unique indexes in the migration, cancelled ones excluded).
model DeskBooking {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  seatId      String    @map("seat_id") @db.Uuid
  personId    String    @map("person_id") @db.Uuid
  day         DateTime  @db.Date
  /// who made the booking (the person, or an editor for them); no FK, like audit actors
  bookedById  String    @map("booked_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelledBy String?   @map("cancelled_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])
  seat   Seat   @relation(fields: [tenantId, seatId], references: [tenantId, id], onDelete: Restrict)
  person Person @relation(fields: [tenantId, personId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, day])
  @@map("desk_bookings")
}

/// Append-only. Who changed what, with before/after snapshots.
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  /// person id of the actor; null = system (sync job, migration…). No FK so the log outlives people.
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_log")
}

/// A home dashboard: which widgets, in which order and size. person_id null = the company default.
model DashboardLayout {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  personId  String?  @map("person_id") @db.Uuid
  /// [{ id, type, size }]
  widgets   Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  person Person? @relation(fields: [tenantId, personId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, personId])
  @@map("dashboard_layouts")
}

enum MovePlanStatus {
  draft
  scheduled
  applied
  cancelled
  failed
}

/// A set of seat changes prepared in advance, applied together (now or on effective_date).
model MovePlan {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  name          String
  note          String?
  status        MovePlanStatus @default(draft)
  /// the day it happens (Swiss calendar day; the nightly job applies it early that morning)
  effectiveDate DateTime?      @map("effective_date") @db.Date
  createdById   String         @map("created_by") @db.Uuid
  scheduledById String?        @map("scheduled_by") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  appliedAt     DateTime?      @map("applied_at") @db.Timestamptz(3)
  /// why a scheduled plan couldn't be applied: [{ code, personId?, seatId? }]
  problems      Json?

  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  createdBy   Person         @relation("MovePlanCreatedBy", fields: [tenantId, createdById], references: [tenantId, id], onDelete: Restrict)
  scheduledBy Person?        @relation("MovePlanScheduledBy", fields: [tenantId, scheduledById], references: [tenantId, id], onDelete: Restrict)
  items       MovePlanItem[]

  @@unique([tenantId, id])
  @@index([tenantId, status, effectiveDate])
  @@map("move_plans")
}

/// One person's planned seat. to_seat_id null = they give up their seat.
model MovePlanItem {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  planId   String  @map("plan_id") @db.Uuid
  personId String  @map("person_id") @db.Uuid
  toSeatId String? @map("to_seat_id") @db.Uuid

  tenant Tenant   @relation(fields: [tenantId], references: [id])
  plan   MovePlan @relation(fields: [tenantId, planId], references: [tenantId, id], onDelete: Cascade)
  person Person   @relation(fields: [tenantId, personId], references: [tenantId, id], onDelete: Restrict)
  // a planned seat that gets deleted drops that move from the plan (applied moves have history,
  // so their seats can't be deleted)
  toSeat Seat?    @relation(fields: [tenantId, toSeatId], references: [tenantId, id], onDelete: Cascade)

  @@unique([planId, personId])
  @@map("move_plan_items")
}

/// One-time sign-in links (only the token's hash). Used only through SQL functions
/// (email_sign_in_create / email_sign_in_use), never by the app role directly.
model EmailSignIn {
  tokenHash   String    @id @map("token_hash")
  email       String
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)
  /// the 6-digit code in the same e-mail (its hash), for typing in instead of opening the link
  codeHash    String?   @map("code_hash")
  failedCodes Int       @default(0) @map("failed_codes")

  @@index([email, createdAt])
  @@map("email_sign_ins")
  @@ignore
}

/// Sessions someone signed out of (the cookie's sid), until the cookie would have expired.
/// Used only through SQL functions (session_sign_out / session_signed_out).
model SignedOutSession {
  sid       String   @id
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@map("signed_out_sessions")
  @@ignore
}

/// Things to find one's way on a floor (kitchen, printer, exits…).
model FloorMarker {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  floorId   String   @map("floor_id") @db.Uuid
  kind      String
  x         Float
  y         Float
  label     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  floor  Floor  @relation(fields: [tenantId, floorId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, floorId])
  @@map("floor_markers")
}

/// Space planning: how many people a team expects (after hiring), by when.
model TeamPlan {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  team      String
  headcount Int
  byDate    DateTime? @map("by_date") @db.Date
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, team])
  @@map("team_plans")
}

/// Possible customers the operator writes to (the Leads page under /owner). Stored in the
/// operator's own workspace, so RLS applies like everywhere; only owner-checked endpoints use it.
model Lead {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  company        String
  website        String?
  address        String?
  whyNow         String?   @map("why_now")
  sourceUrl      String?   @map("source_url")
  contactName    String?   @map("contact_name")
  greeting       String?
  contactRole    String?   @map("contact_role")
  /// email | form | linkedin
  channel        String    @default("email")
  contactEmail   String?   @map("contact_email")
  linkedinUrl    String?   @map("linkedin_url")
  /// de | fr | en
  language       String    @default("de")
  /// research | ready | sent | followed_up | replied | meeting | customer | no | no_answer
  status         String    @default("research")
  firstSentAt    DateTime? @map("first_sent_at") @db.Timestamptz(3)
  followUpSentAt DateTime? @map("follow_up_sent_at") @db.Timestamptz(3)
  repliedAt      DateTime? @map("replied_at") @db.Timestamptz(3)
  /// the latest automatic answer (out-of-office…): shown on the lead, never counts as a reply
  autoReplyAt      DateTime? @map("auto_reply_at") @db.Timestamptz(3)
  autoReplySubject String?   @map("auto_reply_subject")
  notes          String?
  /// company size (people working there)
  employees      Int?
  /// moving | growing | hybrid | multiple_sites | microsoft365 | warm (LEAD_TAGS)
  tags           String[]  @default([])
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  messages LeadMessage[]

  @@index([tenantId, status])
  @@map("leads")
}

/// One e-mail to a lead: scheduled (sent by the morning job), sent, or cancelled.
model LeadMessage {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  leadId       String    @map("lead_id") @db.Uuid
  /// first | follow_up | ask_why
  kind         String
  subject      String
  body         String
  toAddress    String    @map("to_address")
  scheduledFor DateTime  @map("scheduled_for") @db.Timestamptz(3)
  sentAt       DateTime? @map("sent_at") @db.Timestamptz(3)
  canceledAt   DateTime? @map("canceled_at") @db.Timestamptz(3)
  /// the Message-ID header (a follow-up refers to the first e-mail's)
  messageId    String    @map("message_id")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId, scheduledFor])
  @@map("lead_messages")
}
